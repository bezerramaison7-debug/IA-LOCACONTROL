# Paths relativos são resolvidos contra a raiz do projeto.
LOCACONTROL_DATABASE_URL=sqlite:///./data/locacontrol.db
# JSON: origens explícitas. O proxy local dispensa CORS para o uso normal.
LOCACONTROL_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Usado apenas pelo servidor Vite, nunca como segredo no navegador.
LOCACONTROL_PROXY_TARGET=http://127.0.0.1:8000
# Não colocar credenciais reais neste arquivo de exemplo.
# Origens exatas autorizadas a enviar ações autenticadas (CSRF). Acrescente a URL real ao usar LAN/HTTPS.
LOCACONTROL_ALLOWED_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000","http://localhost:5173","http://127.0.0.1:5173","http://127.0.0.1:4173"]
# true quando servido via HTTPS; HTTP é apenas para uso local de desenvolvimento.
LOCACONTROL_COOKIE_SECURE=false
LOCACONTROL_SESSION_HOURS=8
# Dados da locadora impressos em orçamentos e contratos.
LOCACONTROL_COMPANY_NAME=LocaControl
LOCACONTROL_COMPANY_DOCUMENT=
LOCACONTROL_COMPANY_ADDRESS=
LOCACONTROL_COMPANY_CONTACT=
